# .env.example — generated by AI (via LocalMask)
# ──────────────────────────────────────────────
# LOCAL DEV:  copy to .env and fill in your values
# AZURE:      add each var to Key Vault, reference in App Settings
# AWS:        add each var to Secrets Manager, reference in Lambda env vars
# GCP:        add each var to Secret Manager, mount in Cloud Run env vars
#
# The ~[TOKEN]~ values below are restored to real values
# by running: localmask rehydrate <scan_id> .env.example

STRIPE_API_KEY=~[STRIPE_SECRET_KEY_0]~
STRIPE_WEBHOOK_SECRET=~[STRIPE_WEBHOOK_SECRET_1]~

DB_HOST=~[INTERNAL_FQDN_3]~
DB_NAME=payments
DB_USER=admin
DB_PASSWORD=~[DATABASE_PASSWORD_2]~

SENDGRID_KEY=~[SENDGRID_KEY_0]~
FROM_EMAIL=~[EMAIL_2]~

SLACK_WEBHOOK_URL=~[SLACK_WEBHOOK_0]~

PORT=~[NETWORK_PORT_0]~

# .env.demo — credentials for the DEMO ONLY
# These are safe to configure because they only control access to:
#   - The MASKED repo (no real secrets in it)
#   - The AI platform (read-only agent, no production access)
#
# Copy this file to .env.demo and fill in your values.
# Never put PRODUCTION credentials here.

# ── LocalMask ────────────────────────────────────────────────────────────────
LOCALMASK_SCAN_ID=           # From: localmask scan . --sensitivity strict
MASKED_REPO_URL=             # e.g. https://github.com/~[GIT_REMOTE_URL_0]~

# ── Anthropic (easiest — works without any cloud account) ────────────────────
ANTHROPIC_API_KEY=           # From: console.anthropic.com → API Keys

# ── Azure AI Foundry (enterprise demo) ───────────────────────────────────────
AZURE_AI_ENDPOINT=           # e.g. https://your-project.services.ai.azure.com
AZURE_AI_PROJECT=            # Your Foundry project name
AZURE_MODEL=claude-sonnet-4-6  # Model deployed in your Foundry project

# ── AWS Bedrock (optional) ───────────────────────────────────────────────────
# AWS_ACCESS_KEY_ID=         # IAM key with bedrock:InvokeModel only
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=~[AWS_REGION_0]~

# ── GCP Vertex AI (optional) ─────────────────────────────────────────────────
# GCP_PROJECT_ID=
# GCP_REGION=us-central1
